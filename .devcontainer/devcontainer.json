{
  "name": "AppSec Ascent",
  "image": "mcr.microsoft.com/devcontainers/dotnet:10.0",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/azure/azure-dev/azd:0": {}
  },
  "hostRequirements": {
    "cpus": 2
  },
  "postCreateCommand": "python3 -m pip install --user uv && dotnet restore AppSecAscent.slnx && ./ascent lint --plain",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "yaml.schemas": {
          "./schemas/exam-outline.schema.json": "curriculum/outline/*.yaml",
          "./schemas/lab-manifest.schema.json": "labs/*/lab.yaml",
          "./schemas/deliverable.schema.json": "deliverables/templates/*.yaml",
          "./schemas/rubric.schema.json": "deliverables/rubrics/*.yaml",
          "./schemas/drill.schema.json": "curriculum/drills/*.yaml",
          "./schemas/season.schema.json": "curriculum/season.yaml",
          "./schemas/exceptions.schema.json": "security/exceptions.yaml"
        }
      }
    }
  }
}
