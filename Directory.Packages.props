<Project>
  <!-- Central Package Management. Every dependency must use a permissive license (LIC-U1-01). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Runtime -->
    <PackageVersion Include="Spectre.Console.Cli" Version="0.57.2" />            <!-- MIT -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />                     <!-- MIT -->
    <PackageVersion Include="Markdig" Version="1.4.0" />                         <!-- BSD-2-Clause -->
    <PackageVersion Include="LateApexEarlySpeed.Json.Schema" Version="4.2.0" />  <!-- BSD-3-Clause -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />         <!-- MIT; native SQLitePCLRaw bundle: Apache-2.0 -->
    <!-- Tests (Microsoft.Testing.Platform runner, opted in via global.json) -->
    <PackageVersion Include="xunit.v3" Version="4.0.1" />                        <!-- Apache-2.0 -->
    <PackageVersion Include="Shouldly" Version="4.3.0" />                        <!-- BSD-3-Clause -->
    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />                   <!-- MIT; line coverage for the CI gate (TEST-U2-01) -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />  <!-- MIT; FakeTimeProvider -->
  </ItemGroup>
</Project>
