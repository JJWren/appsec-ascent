{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JJWren/appsec-ascent/schemas/deliverable.v1.schema.json",
  "title": "Deliverable template",
  "description": "Structured template for a non-code practical exercise. The reference answer is Sealed (tier 'submitted').",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "objectiveIds", "title", "sections", "rubricId", "referenceRef", "portfolioEligible"],
  "properties": {
    "id": { "type": "string" },
    "objectiveIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^([1-8]\\.\\d{1,2}|ORI-\\d+|CAP-\\d+)$" }
    },
    "title": { "type": "string", "minLength": 3 },
    "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/section" } },
    "rubricId": { "type": "string" },
    "referenceRef": { "type": "string" },
    "portfolioEligible": { "type": "boolean" }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title", "required", "fields"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 2 },
        "required": { "type": "boolean" },
        "minItems": { "type": "integer", "minimum": 0 },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "required"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "type": { "enum": ["text", "markdown", "list", "enum", "number", "date", "reference"] },
        "required": { "type": "boolean" },
        "options": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
