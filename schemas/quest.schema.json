{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JJWren/appsec-ascent/schemas/quest.v1.schema.json",
  "title": "Quest front matter",
  "description": "YAML front matter of a Quest: one Markdown lesson per exam Objective (or ORI-/CAP- for Orientation and Capstone).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "objectiveId", "outlineVersion", "examDomain", "release", "title", "estimatedMinutes", "status", "citations", "aiLens", "activities"],
  "properties": {
    "id": { "type": "string" },
    "objectiveId": { "type": "string", "pattern": "^([1-8]\\.\\d{1,2}|ORI-\\d+|CAP-\\d+)$" },
    "outlineVersion": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "examDomain": { "enum": ["D1", "D2", "D3", "D4", "D5", "D6", "D7", "D8", "ORI", "CAP"] },
    "release": { "type": "integer", "minimum": 0, "maximum": 9 },
    "title": { "type": "string", "minLength": 3 },
    "estimatedMinutes": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "review", "published"] },
    "citations": { "type": "array", "items": { "$ref": "#/$defs/citation" } },
    "aiLens": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["anchor", "topics"],
          "properties": {
            "anchor": { "type": "string", "minLength": 1 },
            "topics": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        }
      ]
    },
    "activities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["labs", "drills", "deliverables"],
      "properties": {
        "labs": { "type": "array", "items": { "type": "string" } },
        "drills": { "type": "array", "items": { "type": "string" } },
        "deliverables": { "type": "array", "items": { "type": "string" } }
      }
    },
    "deepDive": { "type": ["string", "null"], "pattern": "^dd-[1-9]$" }
  },
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "publisher", "kind", "role"],
      "properties": {
        "id": { "type": "string", "pattern": "^c\\d+$" },
        "title": { "type": "string", "minLength": 3 },
        "publisher": { "type": "string", "minLength": 2 },
        "url": { "type": "string", "format": "uri" },
        "version": { "type": "string" },
        "published": { "type": "string" },
        "accessed": { "type": "string", "format": "date" },
        "kind": { "enum": ["standard", "guidance", "docs", "paper", "book"] },
        "role": { "enum": ["primary", "seeAlso"] }
      }
    }
  }
}
