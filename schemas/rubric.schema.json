{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JJWren/appsec-ascent/schemas/rubric.v1.schema.json",
  "title": "Rubric",
  "description": "Scoring rubric for a Deliverable. Criterion weights sum to 100.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "criteria", "passThreshold"],
  "properties": {
    "id": { "type": "string" },
    "passThreshold": { "type": "integer", "minimum": 50, "maximum": 100 },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "description", "weight", "levels"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "description": { "type": "string", "minLength": 5 },
          "weight": { "type": "integer", "minimum": 1, "maximum": 100 },
          "levels": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["score", "descriptor"],
              "properties": {
                "score": { "type": "integer", "minimum": 0, "maximum": 4 },
                "descriptor": { "type": "string", "minLength": 3 }
              }
            }
          }
        }
      }
    }
  }
}
