{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JJWren/appsec-ascent/schemas/question.v1.schema.json",
  "title": "Question (Sealed plaintext)",
  "description": "Plaintext form of a Question Bank item. Instances live only in the private sealed repository; the public repository ships them as Sealed Bundles.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "objectiveId", "outlineVersion", "type", "stem", "options", "answer", "citations", "difficulty", "aiLens", "pool", "attestation"],
  "properties": {
    "id": { "type": "string" },
    "objectiveId": { "type": "string", "pattern": "^[1-8]\\.\\d{1,2}$" },
    "outlineVersion": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "type": { "enum": ["single", "multi", "ordering", "matching"] },
    "stem": { "type": "string", "minLength": 10 },
    "options": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "text", "rationale"],
        "properties": {
          "key": { "type": "string", "pattern": "^[A-Z]$" },
          "text": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 5 },
          "match": { "type": "string" }
        }
      }
    },
    "answer": {
      "description": "single: one key; multi: list of keys; ordering: keys in order; matching: list of 'KEY=match' pairs.",
      "oneOf": [
        { "type": "string", "pattern": "^[A-Z]$" },
        { "type": "array", "minItems": 1, "items": { "type": "string" } }
      ]
    },
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "publisher"],
        "properties": {
          "title": { "type": "string" },
          "publisher": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "accessed": { "type": "string", "format": "date" }
        }
      }
    },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 3 },
    "aiLens": { "type": "boolean" },
    "aiTopic": { "type": ["string", "null"] },
    "pool": { "enum": ["practice", "diagnostic", "simulation"] },
    "reviewState": { "enum": ["unverified", "verified", "bug-reported"] },
    "attestation": { "const": "original-not-exam-recalled" }
  }
}
