{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JJWren/appsec-ascent/schemas/exam-outline.v1.schema.json",
  "title": "Exam outline",
  "description": "Exam domains, weights, objectives (paraphrased) and AI-guidance topics for one outline version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "effectiveDate", "source", "aiGuidanceSource", "domains"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "effectiveDate": { "type": "string", "format": "date" },
    "source": { "type": "string", "format": "uri" },
    "aiGuidanceSource": { "type": "string", "format": "uri" },
    "domains": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/domain" } }
  },
  "$defs": {
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "weight", "objectives", "aiGuidanceTopics"],
      "properties": {
        "id": { "type": "string", "pattern": "^D[1-8]$" },
        "name": { "type": "string", "minLength": 3 },
        "weight": { "type": "integer", "minimum": 1, "maximum": 100 },
        "objectives": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/objective" } },
        "aiGuidanceTopics": { "type": "array", "items": { "$ref": "#/$defs/aiTopic" } }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^[1-8]\\.\\d{1,2}$" },
        "title": { "type": "string", "minLength": 3 }
      }
    },
    "aiTopic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "summary"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "summary": { "type": "string", "minLength": 10 }
      }
    }
  }
}
