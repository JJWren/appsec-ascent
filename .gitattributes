# Normalize line endings (PORT-U1-03): LF everywhere so formatting checks agree on every OS.
* text=auto eol=lf

# Shell scripts and the POSIX wrapper must keep LF.
*.sh   text eol=lf
ascent text eol=lf

# Windows scripts keep CRLF.
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Binary assets.
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.onnx binary
